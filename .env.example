# Environment Variables - SiLapor Kota

# Database (PostgreSQL - gunakan Neon, Supabase, atau provider PostgreSQL lainnya)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# JWT Secret (minimal 32 karakter random string)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"

# Vercel Blob Storage Token (dari Vercel Dashboard -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# App URL (untuk produksi)
NEXT_PUBLIC_APP_URL="https://silapor-kota.vercel.app"

# Opsional: nama mahasiswa untuk footer (atau hardcode di kode)
NEXT_PUBLIC_STUDENT_NAME="Nama Mahasiswa"

